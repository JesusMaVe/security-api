# Valores dev para el ejercicio — en prod usar secretos reales (Vault/SSM) y no commitear .env

# API_SECRET y LDAP_BIND_PASSWORD ya NO van aqui: el repo secret-rotator los rota cada
# 2 minutos y los publica en ../shared/backend.env, que la API relee en caliente.
SECRETS_FILE=/shared/backend.env

# Llave usada SOLO para cifrar/descifrar datos en la base de datos. NO se rota nunca:
# si cambia, los registros ya guardados dejan de poder descifrarse.
DATABASE_ENCRYPTION_KEY=JabvrRXnraXsyPkZFSJmlrp2a9ROBuDkaiDs/TzIM2o=

# LDAP (repo security-ldap). La API hace search-then-bind con la cuenta readonly.
LDAP_URL=ldap://host.docker.internal:389
LDAP_BIND_DN=cn=readonly,dc=example,dc=com
LDAP_USERS_DN=ou=users,dc=example,dc=com

# Ruta del archivo SQLite donde se guardan los registros cifrados.
DB_PATH=/data/app.db

ALLOW_ORIGIN=*
PORT=8080
