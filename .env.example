# Valores dev para el ejercicio — en prod usar secretos reales (Vault/SSM) y no commitear .env

# Secreto que protege la API (rotado automaticamente cada 2 minutos por la app, ver secret.go).
# Este valor solo es el arranque inicial; el valor vivo se comparte via SECRET_SHARE_PATH.
API_SECRET=dev-secret-123

# Llave usada SOLO para cifrar/descifrar datos en la base de datos. NO se rota nunca:
# si cambia, los registros ya guardados dejan de poder descifrarse.
DATABASE_ENCRYPTION_KEY=JabvrRXnraXsyPkZFSJmlrp2a9ROBuDkaiDs/TzIM2o=

# Archivo compartido (montado tambien en el gateway NGINX/OpenResty) donde se publica
# el valor vivo de API_SECRET en cada rotacion.
SECRET_SHARE_PATH=/shared/api_secret.env

# Ruta del archivo SQLite donde se guardan los registros cifrados.
DB_PATH=/data/app.db

ALLOW_ORIGIN=*
PORT=8080
